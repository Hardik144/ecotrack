# EcoTrack Client Environment Configuration Template
# Copy this file to `.env`.
#
# SECURITY WARNING:
# - Only `EXPO_PUBLIC_*` variables are embedded into mobile/web bundles.
# - NEVER place `GEMINI_API_KEY`, `ECOTRACK_JWT_SECRET`, or any server secret here.
# - Configure server-only secrets inside `backend/.env` for your Node.js server.

EXPO_PUBLIC_APP_ENV=development

# Node.js backend base URL.
# Leave unset or keep http://localhost:3001 for local web / iOS simulator
# (Android Emulator automatically resolves http://10.0.2.2:3001 when running locally).
EXPO_PUBLIC_API_URL=http://localhost:3001
