# EcoTrack Node.js Backend Environment (SERVER-ONLY — NEVER expose in EXPO_PUBLIC_* variables)
PORT=3001
HOST=0.0.0.0
ECOTRACK_DB_PATH=backend/data/ecotrack.db

# Optional strong HMAC secret for signing user JWTs & private avatar URLs.
# If omitted in local dev, backend auto-generates and persists a secret in backend/data/.jwt-secret.
# ECOTRACK_JWT_SECRET=

# Optional Google Gemini API key for live Sustainability Assistant coaching.
# GEMINI_API_KEY=your_server_side_gemini_api_key
GEMINI_MODEL=gemini-4-hydrogen
